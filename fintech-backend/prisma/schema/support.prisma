model SupportTicket {
  id           Int           @id @default(autoincrement())
  ticketNumber String        @unique
  userId       Int
  merchantId   Int?
  topic        SupportTopic
  subject      String
  status       SupportStatus @default(OPEN)
  closedById   Int?
  closedAt     DateTime?
  reopenedById Int?
  reopenedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User             @relation("SupportTicketOwner", fields: [userId], references: [id])
  merchant   Merchant?        @relation(fields: [merchantId], references: [id])
  messages   SupportMessage[]

  @@index([userId])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

model SupportMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  senderId   Int
  senderRole String
  body       String
  createdAt  DateTime @default(now())

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User               @relation("SupportMessageSender", fields: [senderId], references: [id])
  attachments SupportAttachment[]

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
}

model SupportAttachment {
  id        Int      @id @default(autoincrement())
  messageId Int
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}