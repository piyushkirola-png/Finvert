# DATABASE
DATABASE_URL="postgresql://postgres:12345@localhost:5432/fintech?connection_limit=100&pool_timeout=60"
REDIS_URL=redis://127.0.0.1:6379

# SERVER 
PORT=4000
NODE_ENV=development

# CRON schedule
CRON_SCHEDULE=0 0 * * *
FX_API_BASE_URL=https://api.exchangerate-api.com/v4/latest

# ENCRYPT KEY
ENCRYPTION_KEY=a1b2c3d4e5f678901234567890abcdef1234567890abcdef1234567890abcdef

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=500
RATE_LIMIT_PAYMENT_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_MAX=6000
RATE_LIMIT_SKIP_WEBHOOKS=true

FRONTEND_URL=http://localhost:5173,http://localhost:5174
BACKEND_URL=http://localhost:4000

# JWT AND AUTHENTICATION
JWT_SECRET="FIN#123$%"
JWT_REFRESH_SECRET="FIN#456$%"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
