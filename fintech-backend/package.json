  "bugs": {
    "url": "https://github.com/krihnabasudevan/fintech-backend/issues"
  },
  "homepage": "https://github.com/krihnabasudevan/fintech-backend#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^8.0.7",
    "prisma": "^6.19.3",
    "redis": "^6.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
